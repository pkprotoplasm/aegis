# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Web dashboard listen address and port
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Public URL of the dashboard — included in admin DM notifications
WEB_BASE_URL=http://localhost:5000

# FastAPI session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=change-me-to-a-random-string

# Discord OAuth2 — create an OAuth2 application at https://discord.com/developers/applications
# Add DISCORD_REDIRECT_URI to the app's "Redirects" list in the OAuth2 settings
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Set to "false" for local HTTP dev; must be "true" in production (HTTPS)
COOKIE_SECURE=false

# SQLite database path (set automatically by Docker; change for local dev)
# DB_PATH=/data/scambot.db

# SMTP settings for sending abuse emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

# IMAP inbox for receiving provider replies
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-abuse-inbox@gmail.com
IMAP_PASS=your-app-password
IMAP_POLL_INTERVAL=300

# Recorded Future Triage — malware sandbox for EXE files found in submitted URLs
# API key required — see https://tria.ge for access.
# Without this key, EXE scanning is skipped entirely.
TRIAGE_API_KEY=

# Optional: enhances RBL / reputation checks (Intelligence → RBL Check button)
# Without these, URLhaus, Spamhaus DBL, and SURBL still run for free.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional: urlscan.io — page screenshots and verdicts (Intelligence → urlscan.io button)
# Without a key, existing public scans are still searched for free.
# With a key, new scans are submitted automatically when no existing scan is found.
URLSCAN_API_KEY=

# Set to 1 to log all outbound actions (emails, Netcraft submissions, IMAP mark-seen)
# without actually sending anything. A banner appears in the dashboard.
DRY_RUN=0
